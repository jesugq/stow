#!/usr/bin/env bash

function pane-tmux-main() {
  "$@"
}

function pane-tmux-side() {
  local command side focus flags target
  [[ $# -gt 2 ]] || return 2
  side=$1
  focus=$2
  shift 2
  case $side in
    left) flags=(-h -b -l 33% -P -F '#{pane_id}') ;;
    right) flags=(-h -l 33% -P -F '#{pane_id}') ;;
    *) return 2 ;;
  esac
  case $focus in
    main|side) ;;
    *) return 2 ;;
  esac
  PANE_TMUX_MAIN_PANE=$(XDG_CONFIG_HOME="$HOME/.config" tmux display-message -p '#{pane_id}') || return
  printf -v command '%q ' "$@"
  command=${command% }
  PANE_TMUX_SIDE_PANE=$(XDG_CONFIG_HOME="$HOME/.config" tmux split-window "${flags[@]}" "$command") || return
  if [[ $focus == main ]]; then
    target=$PANE_TMUX_MAIN_PANE
  else
    target=$PANE_TMUX_SIDE_PANE
  fi
  XDG_CONFIG_HOME="$HOME/.config" tmux select-pane -t "$target"
}
