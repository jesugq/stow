#!/usr/bin/env bash

function ai() {
  local csv="$HOME/.local/share/jesugq/ai.csv"
  local displays=()
  local commands=()
  local labels=()
  local fields
  local cmd
  local display
  local field_count
  local i
  while IFS=, read -rA fields; do
    field_count=${#fields}
    [ "$field_count" -lt 2 ] && continue
    cmd="${fields[1]}"
    display="${fields[-2]}"
    [ -n "${fields[-1]}" ] && display+=" resets ${fields[-1]}"
    displays+=("$display")
    commands+=("$cmd")
    labels+=("${fields[-2]}")
  done < "$csv"

  local selected_display
  selected_display=$(gum choose "${displays[@]}" --header "Which AI do you still have tokens for?:")

  if [ -n "$selected_display" ]; then
    for ((i = 1; i <= ${#displays}; i++)); do
      if [ "${displays[i]}" = "$selected_display" ]; then
        cmd="${commands[i]}"
        echo "Running ${labels[i]}"
        eval "$cmd"
        break
      fi
    done
  fi
}

function airld() {
  local csv="$HOME/.local/share/jesugq/ai.csv"
  local rows=()
  local displays=()
  local fields
  local row
  local display
  local field_count
  local cmd
  local i

  while IFS= read -r row; do
    [ -z "$row" ] && continue
    IFS=, read -rA fields <<< "$row"
    field_count=${#fields}
    [ "$field_count" -lt 2 ] && continue
    display="${fields[-2]}"
    [ -n "${fields[-1]}" ] && display+=" resets on ${fields[-1]}"
    rows+=("$row")
    displays+=("$display")
  done < "$csv"

  local selected_display
  selected_display=$(gum choose "${displays[@]}" --header "Which AI have you run out of tokens for?:") || return

  local selected_index=0
  for ((i = 1; i <= ${#displays}; i++)); do
    if [ "${displays[i]}" = "$selected_display" ]; then
      selected_index=$i
      break
    fi
  done

  [ "$selected_index" -eq 0 ] && return 1

  local text
  text=$(gum input --placeholder "Text to add to $selected_display:") || return

  local tmp
  tmp=$(mktemp "${csv}.tmp.XXXXXX") || return 1
  for ((i = 1; i <= ${#rows}; i++)); do
    if [ "$i" -eq "$selected_index" ]; then
      IFS=, read -rA fields <<< "${rows[i]}"
      if [ "${#fields}" -eq 2 ]; then
        fields+=("$text")
      else
        fields[-1]="$text"
      fi
      print -r -- "${(j:,:)fields}" >> "$tmp"
    else
      printf '%s\n' "${rows[i]}" >> "$tmp"
    fi
  done
  mv "$tmp" "$csv"
}

