#!/usr/bin/env bash

ai() {
  [ -n "${ZSH_VERSION:-}" ] && setopt LOCAL_OPTIONS KSH_ARRAYS
  local csv="$HOME/.local/share/jesugq/ai.csv"
  local -a displays commands labels
  local cmd label reset display selected_display i

  displays=()
  commands=()
  labels=()

  while IFS=, read -r cmd label reset || [ -n "$cmd" ]; do
    [ -z "$cmd" ] || [ -z "$label" ] && continue
    display="$label"
    [ -n "$reset" ] && display+=" resets $reset"
    displays+=("$display")
    commands+=("$cmd")
    labels+=("$label")
  done < "$csv"

  selected_display=$(gum choose "${displays[@]}" --header "Which AI do you still have tokens for?:")
  [ -z "$selected_display" ] && return

  i=0
  for display in "${displays[@]}"; do
    if [ "$display" = "$selected_display" ]; then
      echo "Running ${labels[i]}"
      eval "${commands[i]}"
      break
    fi
    i=$((i + 1))
  done
}

airld() {
  [ -n "${ZSH_VERSION:-}" ] && setopt LOCAL_OPTIONS KSH_ARRAYS
  local csv="$HOME/.local/share/jesugq/ai.csv"
  local -a rows displays
  local row cmd label reset display selected_display text tmp i selected_index

  rows=()
  displays=()

  while IFS= read -r row || [ -n "$row" ]; do
    [ -z "$row" ] && continue
    IFS=, read -r cmd label reset <<< "$row"
    [ -z "$cmd" ] || [ -z "$label" ] && continue
    display="$label"
    [ -n "$reset" ] && display+=" resets on $reset"
    rows+=("$row")
    displays+=("$display")
  done < "$csv"

  selected_display=$(gum choose "${displays[@]}" --header "Which AI have you run out of tokens for?:") || return

  selected_index=-1
  i=0
  for display in "${displays[@]}"; do
    if [ "$display" = "$selected_display" ]; then
      selected_index=$i
      break
    fi
    i=$((i + 1))
  done
  [ "$selected_index" -lt 0 ] && return 1

  text=$(gum input --placeholder "Text to add to $selected_display:") || return

  tmp=$(mktemp "${csv}.tmp.XXXXXX") || return 1
  i=0
  for row in "${rows[@]}"; do
    if [ "$i" -eq "$selected_index" ]; then
      IFS=, read -r cmd label reset <<< "$row"
      printf '%s,%s,%s\n' "$cmd" "$label" "$text" >> "$tmp"
    else
      printf '%s\n' "$row" >> "$tmp"
    fi
    i=$((i + 1))
  done
  mv "$tmp" "$csv"
}
