#!/usr/bin/env python3

"""Record the MacBook camera until `cam stop`, or for a given number of seconds.

The pointer watcher starts this when the cursor ends afk. q does not. Once
the camera is open the recorder leaves that session, so the window closing
does not reach it.
"""

import fcntl
import hashlib
import os
import select
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path.home() / "Development" / "golazos"
CACHE = Path.home() / "Library" / "Caches" / "afk"
LOCK = CACHE / "cam.lock"
LOG = CACHE / "cam.log"
SWIFT = Path(__file__).resolve().with_name("cam.swift")
BINARY = CACHE / "cam-capture"
STAMP = CACHE / "cam-capture.sha256"
READY_WAIT = 120


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if sys.platform != "darwin":
        sys.stderr.write("cam: camera recording is macOS only\n")
        return 1
    if command == "start":
        return start()
    if command == "stop":
        return stop()
    if command == "status":
        return status()
    sys.stderr.write("usage: cam start [seconds]|stop|status\n")
    return 2


def start():
    ROOT.mkdir(parents=True, exist_ok=True)
    CACHE.mkdir(parents=True, exist_ok=True)
    seconds = recording_seconds()
    if not ensure_binary():
        return 1
    lock_fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(lock_fd)
        return 0
    path = ROOT / time.strftime("Camera Recording %Y-%m-%d at %-I.%M.%S %p.mov")
    log_pos = LOG.stat().st_size if LOG.exists() else 0
    log_fp = open(LOG, "ab", buffering=0)
    command = [str(BINARY), str(path)]
    if seconds is not None:
        command.append(str(seconds))
    proc = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=log_fp,
        cwd=ROOT,
        pass_fds=(lock_fd,),
    )
    log_fp.close()
    os.ftruncate(lock_fd, 0)
    os.lseek(lock_fd, 0, os.SEEK_SET)
    os.write(lock_fd, f"{proc.pid} {path}\n".encode())
    os.close(lock_fd)
    if wait_ready(proc):
        return 0
    tail = ""
    if LOG.exists():
        with LOG.open("rb") as handle:
            handle.seek(log_pos)
            tail = handle.read().decode(errors="replace").strip()
    if tail:
        sys.stderr.write(tail + "\n")
    else:
        sys.stderr.write("cam: camera did not start\n")
    return 1


def recording_seconds():
    if len(sys.argv) < 3:
        return None
    try:
        seconds = float(sys.argv[2])
    except ValueError:
        seconds = 0
    if seconds <= 0:
        sys.stderr.write("cam: duration expected\n")
        raise SystemExit(2)
    return seconds


def wait_ready(proc):
    deadline = time.monotonic() + READY_WAIT
    fd = proc.stdout.fileno()
    buf = b""
    while time.monotonic() < deadline:
        remain = deadline - time.monotonic()
        readable, _, _ = select.select([fd], [], [], min(remain, 0.2))
        if readable:
            chunk = os.read(fd, 256)
            buf += chunk
            if b"ready" in buf:
                return True
            if chunk == b"" and proc.poll() is not None:
                return False
        if proc.poll() is not None:
            return False
    if proc.poll() is None:
        proc.kill()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            pass
    return False


def stop():
    pid, path = read_lock()
    if pid is None or not alive(pid):
        sys.stderr.write("cam: not recording\n")
        return 1
    os.kill(pid, signal.SIGINT)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline and alive(pid):
        time.sleep(0.1)
    if alive(pid):
        os.kill(pid, signal.SIGKILL)
        sys.stderr.write("cam: recorder did not finish; the file may be incomplete\n")
        return 1
    if path:
        sys.stdout.write(path + "\n")
    return 0


def status():
    pid, path = read_lock()
    if pid is None or not alive(pid):
        sys.stderr.write("cam: not recording\n")
        return 1
    if path:
        sys.stdout.write(path + "\n")
    return 0


def read_lock():
    try:
        text = LOCK.read_text().strip()
    except OSError:
        return None, ""
    pid_text, _, path = text.partition(" ")
    try:
        return int(pid_text), path
    except ValueError:
        return None, ""


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def ensure_binary():
    digest = hashlib.sha256(SWIFT.read_bytes()).hexdigest()
    if BINARY.is_file() and STAMP.is_file() and STAMP.read_text() == digest:
        return True
    swiftc = shutil.which("swiftc")
    if swiftc is None:
        sys.stderr.write("cam: swiftc: command not found\n")
        return False
    result = subprocess.run(
        [swiftc, "-Onone", "-o", str(BINARY), str(SWIFT)],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr or "cam: swiftc failed\n")
        return False
    STAMP.write_text(digest)
    return True


if __name__ == "__main__":
    sys.exit(main())
