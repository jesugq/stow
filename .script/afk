#!/usr/bin/env bash

messages="$HOME/.script/actioning.txt"
names="$HOME/.script/teammates.txt"
reasoning="$HOME/.script/reasoning.txt"
protips="$HOME/.script/protiping.txt"
for file in "$messages" "$names" "$reasoning" "$protips"; do
  if [[ ! -f $file ]]; then
    printf 'afk: %s: No such file or directory\n' "$file" >&2
    exit 1
  fi
  if [[ ! -s $file ]]; then
    printf 'afk: %s: file is empty\n' "$file" >&2
    exit 1
  fi
done

scenes=(waveform constellation rain particles pipes orrery starfield dvd boids bonsai)
themes=(cosmic dracula catppuccin gruvbox mono rosepine)

for ((i=${#scenes[@]}-1; i>0; i--)); do
  j=$((RANDOM % (i+1)))
  tmp=${scenes[i]}
  scenes[i]=${scenes[j]}
  scenes[j]=$tmp
done
unset i j tmp

IFS=,
scene="${scenes[*]}"
unset IFS
theme="${themes[RANDOM % ${#themes[@]}]}"

sides=(left right)
side="${sides[RANDOM % ${#sides[@]}]}"
focuses=(main side)
focus="${focuses[RANDOM % ${#focuses[@]}]}"

pane-tmux-main() {
  "$@"
}

pane-tmux-side() {
  local command side focus flags target
  [[ $# -gt 2 ]] || return 2
  side=$1
  focus=$2
  shift 2
  case $side in
    left) flags=(-h -b -l 33% -P -F '#{pane_id}') ;;
    right) flags=(-h -l 33% -P -F '#{pane_id}') ;;
    *) return 2 ;;
  esac
  case $focus in
    main|side) ;;
    *) return 2 ;;
  esac
  PANE_TMUX_MAIN_PANE=$(tmux display-message -p '#{pane_id}') || return
  printf -v command '%q ' "$@"
  command=${command% }
  PANE_TMUX_SIDE_PANE=$(tmux split-window "${flags[@]}" "$command") || return
  if [[ $focus == main ]]; then
    target=$PANE_TMUX_MAIN_PANE
  else
    target=$PANE_TMUX_SIDE_PANE
  fi
  tmux select-pane -t "$target"
}

pane-tmux-side "$side" "$focus" "$HOME/.script/thinking_base.py" "$messages" "$names" "$reasoning" "$protips"

# Linux is a managed device: it runs drift in the foreground and never
# watches the pointer. macOS polls the cursor without Accessibility.
if [[ ${OSTYPE:-} != darwin* ]]; then
  pane-tmux-main drift --scene "$scene" --theme "$theme" --duration 5
  exit
fi

drift --scene "$scene" --theme "$theme" --duration 5 &
drift_pid=$!
python3 "$HOME/.script/gol.py" "$drift_pid" "${PANE_TMUX_SIDE_PANE:-}" >/dev/null 2>&1 &
watch_pid=$!
wait "$drift_pid" || true
kill "$watch_pid" 2>/dev/null || true
wait "$watch_pid" 2>/dev/null || true
