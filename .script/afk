#!/usr/bin/env bash

messages="$HOME/.script/actioning.txt"
names="$HOME/.script/teammates.txt"
reasoning="$HOME/.script/reasoning.txt"
for file in "$messages" "$names" "$reasoning"; do
  if [[ ! -f $file ]]; then
    printf 'afk: %s: No such file or directory\n' "$file" >&2
    exit 1
  fi
  if [[ ! -s $file ]]; then
    printf 'afk: %s: file is empty\n' "$file" >&2
    exit 1
  fi
done

if [[ "${OSTYPE:-}" == darwin* ]]; then
  arch="$HOME/.binary/drift_darwin"
else
  arch="$HOME/.binary/drift_linux"
fi

scenes=(waveform constellation rain particles pipes orrery starfield dvd boids bonsai)
themes=(cosmic nord dracula catppuccin gruvbox forest wildberries mono rosepine)

for ((i=${#scenes[@]}-1; i>0; i--)); do
  j=$((RANDOM % (i+1)))
  tmp=${scenes[i]}
  scenes[i]=${scenes[j]}
  scenes[j]=$tmp
done
unset i j tmp

IFS=,
scene="${scenes[*]}"
unset IFS
theme="${themes[RANDOM % ${#themes[@]}]}"

thinkings=(
  "$HOME/.script/thinking_antigravity.py"
  "$HOME/.script/thinking_claude.py"
  "$HOME/.script/thinking_codex.py"
  "$HOME/.script/thinking_copilot.py"
  "$HOME/.script/thinking_cursor.py"
  "$HOME/.script/thinking_opencode.py"
  "$HOME/.script/thinking_qwen.py"
)
thinking="${thinkings[RANDOM % ${#thinkings[@]}]}"
sides=(left right)
side="${sides[RANDOM % ${#sides[@]}]}"
focuses=(main side)
focus="${focuses[RANDOM % ${#focuses[@]}]}"

pane-tmux-main() {
  "$@"
}

pane-tmux-side() {
  local command side focus flags target
  [[ $# -gt 2 ]] || return 2
  side=$1
  focus=$2
  shift 2
  case $side in
    left) flags=(-h -b -l 33% -P -F '#{pane_id}') ;;
    right) flags=(-h -l 33% -P -F '#{pane_id}') ;;
    *) return 2 ;;
  esac
  case $focus in
    main|side) ;;
    *) return 2 ;;
  esac
  PANE_TMUX_MAIN_PANE=$(tmux display-message -p '#{pane_id}') || return
  printf -v command '%q ' "$@"
  command=${command% }
  PANE_TMUX_SIDE_PANE=$(tmux split-window "${flags[@]}" "$command") || return
  if [[ $focus == main ]]; then
    target=$PANE_TMUX_MAIN_PANE
  else
    target=$PANE_TMUX_SIDE_PANE
  fi
  tmux select-pane -t "$target"
}

pane-tmux-side "$side" "$focus" "$thinking" "$messages" "$names" "$reasoning"

# Linux is a managed device: it runs drift in the foreground and never
# watches the pointer. macOS polls the cursor without Accessibility.
if [[ ${OSTYPE:-} != darwin* ]]; then
  pane-tmux-main "$arch" --scene "$scene" --theme "$theme" --duration 10
  exit
fi

pointer-watch-darwin() {
  python3 - "$@" << 'PY'
import ctypes
import os
import signal
import subprocess
import sys
import time

# One Quartz point. The animation is started from the keyboard, so any
# real pointer travel means the machine is back in use.
MOVE = 1

drift_pid = int(sys.argv[1])
pane = sys.argv[2]

core = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")


class CGPoint(ctypes.Structure):
    _fields_ = [("x", ctypes.c_double), ("y", ctypes.c_double)]


core.CGEventCreate.restype = ctypes.c_void_p
core.CGEventCreate.argtypes = [ctypes.c_void_p]
core.CGEventGetLocation.restype = CGPoint
core.CGEventGetLocation.argtypes = [ctypes.c_void_p]
core.CFRelease.restype = None
core.CFRelease.argtypes = [ctypes.c_void_p]


def point():
    event = core.CGEventCreate(None)
    if not event:
        return None
    location = core.CGEventGetLocation(event)
    core.CFRelease(event)
    return location.x, location.y


def stop():
    # Close the thinking split first. The shell then exits, the afk
    # window is destroyed, and tmux selects the previous window.
    if pane:
        subprocess.run(
            ["tmux", "kill-pane", "-t", pane],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.kill(drift_pid, sig)
        except OSError:
            return
        deadline = time.monotonic() + 0.2
        while time.monotonic() < deadline:
            try:
                os.kill(drift_pid, 0)
            except OSError:
                return
            time.sleep(0.02)


origin = None
while origin is None:
    origin = point()
    if origin is None:
        time.sleep(0.05)

while True:
    time.sleep(0.05)
    current = point()
    if current is None:
        continue
    if abs(current[0] - origin[0]) >= MOVE or abs(current[1] - origin[1]) >= MOVE:
        stop()
        raise SystemExit(0)
PY
}

"$arch" --scene "$scene" --theme "$theme" --duration 10 &
drift_pid=$!
pointer-watch-darwin "$drift_pid" "${PANE_TMUX_SIDE_PANE:-}" >/dev/null 2>&1 &
watch_pid=$!
wait "$drift_pid" || true
kill "$watch_pid" 2>/dev/null || true
wait "$watch_pid" 2>/dev/null || true
