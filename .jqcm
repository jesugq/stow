#!/usr/bin/env bash

alias jolt='XDG_CONFIG_HOME="$HOME/.config" jolt'

function yz() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  XDG_CONFIG_HOME="$HOME/.config" command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}
