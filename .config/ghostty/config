# theme
theme = Ryuuko

# font
font-family = "Maple Mono NF"
font-size = 24.0
# font-size = 18.0

# window
window-padding-balance = true
window-padding-x = 8
window-padding-y = 0
adjust-cell-height = +5%
# adjust-cell-height = +0%

# chrome support
keybind = super+digit_1=csi:49;9u
keybind = super+digit_2=csi:50;9u
keybind = super+digit_3=csi:51;9u
keybind = super+digit_4=csi:52;9u
keybind = super+digit_5=csi:53;9u
keybind = super+digit_6=csi:54;9u
keybind = super+digit_7=csi:55;9u
keybind = super+digit_8=csi:56;9u
keybind = super+digit_9=csi:57;9u

# linux support
keybind = alt+enter=csi:13;3u
keybind = ctrl+enter=csi:13;5u

# macos support
keybind = super+h=csi:104;9u
keybind = super+j=csi:106;9u
keybind = super+k=csi:107;9u
keybind = super+l=csi:108;9u
keybind = super+enter=csi:13;9u

# globe support
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

