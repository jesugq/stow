# theme
theme = Ryuuko

# font
font-family = "Maple Mono NF"
font-size = 18.0

# window
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0

# linux support
keybind = ctrl+shift+,=reload_config
keybind = ctrl+enter=csi:13;5u
keybind = super+enter=csi:13;9u

# macos support
# alt+[ -> cmd+shift+[ == prev tab
# alt+] -> cmd+shift+} == next tab
keybind = super+shift+,=reload_config
keybind = super+shift+left_bracket=csi:123;3u
keybind = super+shift+right_bracket=csi:125;3u
keybind = super+h=csi:104;9u
keybind = super+j=csi:106;9u
keybind = super+k=csi:107;9u
keybind = super+l=csi:108;9u
keybind = alt+enter=csi:13;3u

# globe support
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
