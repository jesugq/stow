mode = "hold"
notify = true

[speeds]
slow = 200
normal = 400
fast = 2000
scroll_slow = 20
scroll = 40
scroll_fast = 200

[easing]
movement = 0.4
scroll = 0.4

[keys]
# linux
# reload_config = "super + shift + r"
# config_screen = "super + shift + slash"
# macos
reload_config = "option + shift + r"
config_screen = "option + shift + slash"
# globe
left_click = "space"
locate = "q"
toggle_hold = "w"
middle_click = "o"
right_click = "p"
fast = "s"
slow = "a"
left = "h"
down = "j"
up = "k"
right = "l"
scroll_left = "."
scroll_down = "m"
scroll_up = ","
scroll_right = "n"

[keycast]
enabled = true
hotkey = "esc"
max_keys = 8
timeout = 3

[remap]
chord_timeout = 50

[remap.main]
"d+f" = "free_mouse"
"j+k" = "escape"
escape = "ctrl"
capslock = "ctrl"
rightalt = "ctrl"
rightctrl = "rightalt"

[hints]
recursive_grid_enabled = false
label_symbols = "abcdefghijklmnopqrstuvwxyz"
border_color = "#00ff00e0"
fill_color = "#00ff0018"
readability_color = "#404040e6"
label_color = "#ffffffff"
label_highlight_color = "#ffc107ff"
min_width = 8
max_width = 499
min_height = 4
max_height = 96

[hints.keys]
# linux
# left = "super + shift + space"
# right = "super + shift + i"
# grid = "super + shift + g"
# macos
left = "option + shift + space"
right = "option + shift + i"
grid = "option + shift + g"
# globe
grid_upper_left = "u"
grid_upper_right = "i"
grid_lower_left = "j"
grid_lower_right = "k"
grid_left_click = "space"
grid_right_click = "r"
cancel = "enter"
toggle_background = "ctrl"
debug = "f8"
