mode = "hold"
notify = true

[speeds]

scroll_slow = 20
scroll = 40
scroll_fast = 200
# scroll_slow = 5
# scroll = 10
# scroll_fast = 50

# globe
slow = 200
normal = 400
fast = 2000

[easing]

movement = 0.4
scroll = 0.4

[keys]

config_screen = "f25"
reload_config = "super + alt + r"
left_click = "space"
middle_click = "enter"
right_click = "leftctrl"
locate = "o"
toggle_hold = "p"
fast = "s"
slow = "a"
left = "h"
down = "j"
up = "k"
right = "l"
scroll_left = "."
scroll_down = "m"
scroll_up = ","
scroll_right = "n"

[keycast]

enabled = true
hotkey = "q"
max_keys = 3
timeout = 3

[remap]

chord_timeout = 50

[remap.main]

"a+s" = "layer(nav)"
"d+f" = "free_mouse"
"j+k" = "escape"
"l+semicolon" = "escape"
escape = "ctrl"
capslock = "ctrl"
rightalt = "ctrl"
rightctrl = "rightalt"

[remap.layers.nav]

d = "ctrl"
f = "shift"
h = "left"
j = "down"
k = "up"
l = "right"
n = "home"
m = "pagedown"
"," = "pageup"
"." = "end"

[hints]

recursive_grid_enabled = false
label_symbols = "abcdefghijklmnopqrstuvwxyz"
border_color = "#00ff00e0"
fill_color = "#00ff0018"
readability_color = "#404040e6"
label_color = "#ffffffff"
label_highlight_color = "#ffc107ff"
min_width = 8
max_width = 499
min_height = 4
max_height = 96

[hints.keys]

left = "f25"
right = "f25"
grid = "f25"
grid_upper_left = "f25"
grid_lower_right = "f25"
grid_lower_left = "f25"
grid_upper_right = "f25"
grid_left_click = "f25"
grid_right_click = "f25"
toggle_background = "f25"
cancel = "f25"
debug = "f25"

