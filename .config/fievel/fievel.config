mode = "hold"
notify = true

[speeds]

# linux
# scroll_slow = 5
# scroll = 10
# scroll_fast = 50

# macos
scroll_slow = 20
scroll = 40
scroll_fast = 200

# globe
slow = 200
normal = 400
fast = 2000

[easing]

movement = 0.4
scroll = 0.4

[keys]

# linux
# reload_config = "meta + shift + r"
# config_screen = "meta + shift + slash"

# macos
reload_config = "option + shift + r"
config_screen = "option + shift + slash"

# globe
left_click = "space"
middle_click = "enter"
right_click = "capslock"
locate = "q"
toggle_hold = "z"
fast = "s"
slow = "a"
left = "h"
down = "j"
up = "k"
right = "l"
scroll_left = "."
scroll_down = "m"
scroll_up = ","
scroll_right = "n"

[keycast]

enabled = true
hotkey = "p"
max_keys = 3
timeout = 3

[remap]

chord_timeout = 50

[remap.main]

"a+s" = "layer(dir)"
"d+f" = "free_mouse"
"j+k" = "escape"
"l+semicolon" = "escape"
escape = "ctrl"
capslock = "ctrl"
rightalt = "ctrl"
rightctrl = "rightalt"

[remap.layers.dir]

# linux
# d = "ctrl"

# macos
d = "option"

# globe
f = "shift"
h = "left"
j = "down"
k = "up"
l = "right"
p = "backspace"
slash = "delete"

[hints]

recursive_grid_enabled = false
label_symbols = "abcdefghijklmnopqrstuvwxyz"
border_color = "#00ff00e0"
fill_color = "#00ff0018"
readability_color = "#404040e6"
label_color = "#ffffffff"
label_highlight_color = "#ffc107ff"
min_width = 8
max_width = 499
min_height = 4
max_height = 96

[hints.keys]

# linux
# left = "meta + shift + space"
# right = "meta + shift + i"
# grid = "meta + shift + g"

# macos
left = "option + shift + space"
right = "option + shift + i"
grid = "option + shift + g"

# globe
grid_lower_left = "h"
grid_upper_left = "j"
grid_lower_right = "k"
grid_upper_right = "ŕ"
grid_left_click = "space"
grid_right_click = "ctrl"
cancel = "backspace"
toggle_background = "enter"
debug = "f8"

