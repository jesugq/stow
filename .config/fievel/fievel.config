mode = "toggle"
notify = true

[speeds]
slow = 200
normal = 400
fast = 2000
scroll_slow = 20
scroll = 40
scroll_fast = 200

[easing]
movement = 0.4
scroll = 0.4

[keys]
# linux
# reload_config = "super + shift + r"
# config_screen = "super + shift + slash"
# macos
reload_config = "option + shift + r"
config_screen = "option + shift + slash"
# globe
left = "h"
down = "j"
up = "k"
right = "l"
left_click = "space"
scroll_left = "o"
scroll_down = "u"
scroll_up = "i"
scroll_right = "y"
slow = "d"
fast = "f"
right_click = ","
middle_click = "."
toggle_hold = "slash"
locate = "backslash"

[keycast]
enabled = true
hotkey = "esc"
max_keys = 8
timeout = 3

[remap]
chord_timeout = 50

[remap.main]
"q+w" = "layer(cs)"
"a+s" = "free_mouse"
"z+x" = "layer(as)"
capslock = "ctrl"
rightalt = "ctrl"
rightctrl = "rightalt"

[remap.layers.cs]
# linux
# e = "ctrl"
# leftbrace = "pageup"
# rightbrace = "pagedown"
# macos
e = "cmd"
leftbrace = "leftbrace"
rightbrace = "rightbrace"
# globe
r = "shift"
h = "left"
j = "down"
k = "up"
l = "right"
apostrophe = "tab"

[remap.layers.as]
# linux
# c = "alt"
# macos
c = "option"
# globe
v = "shift"
h = "left"
j = "down"
k = "up"
l = "right"
apostrophe = "tab"
leftbrace = "escape"
rightbrace = "escape"

[hints]
recursive_grid_enabled = false
label_symbols = "abcdefghijklmnopqrstuvwxyz"
border_color = "#00ff00e0"
fill_color = "#00ff0018"
readability_color = "#404040e6"
label_color = "#ffffffff"
label_highlight_color = "#ffc107ff"
min_width = 8
max_width = 499
min_height = 4
max_height = 96

[hints.keys]
# linux
# left = "super + shift + space"
# right = "super + shift + i"
# grid = "super + shift + g"
# macos
left = "option + shift + space"
right = "option + shift + i"
grid = "option + shift + g"
# globe
grid_upper_left = "u"
grid_upper_right = "i"
grid_lower_left = "j"
grid_lower_right = "k"
grid_left_click = "space"
grid_right_click = "r"
cancel = "enter"
toggle_background = "ctrl"
debug = "f8"
