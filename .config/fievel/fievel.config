mode = "hold"
notify = true

[speeds]
normal = 300
slow = 100
fast = 900
scroll = 6
scroll_slow = 1.5
scroll_fast = 24

[easing]
movement = 0.4
scroll = 0.4

[keys]
reload_config = "leftmeta + leftshift + r"
config_screen = "leftmeta + leftshift + slash"
toggle_hold = "z"
left = "h"
down = "j"
up = "k"
right = "l"
left_click = "space"
right_click = ","
middle_click = "."
scroll_left = "u"
scroll_down = "i"
scroll_up = "o"
scroll_right = "p"
fast = "s"
locate = "q"

[keycast]
enabled = true
hotkey = "esc"
max_keys = 8
timeout = 3

[remap]
chord_timeout = 100

[remap.main]
"d+f" = "free_mouse"
"a+s" = "layer(dir)"
"q+w" = "layer(nav)"
capslock = "leftctrl"
rightalt = "leftctrl"
rightctrl = "rightalt"

[remap.layers.dir]
d = "leftalt"
h = "left"
j = "down"
k = "up"
l = "right"
apostrophe = "tab"
leftbrace = "escape"
rightbrace = "escape"

[remap.layers.nav]
# linux
e = "leftctrl"
r = "leftctrl"
leftbrace = "pageup"
rightbrace = "pagedown"
# macos
# e = "leftalt"
# r = "leftshift"

[hints]
recursive_grid_enabled = false
label_symbols = "abcdefghijklmnopqrstuvwxyz"
border_color = "#00ff00e0"
fill_color = "#00ff0018"
readability_color = "#404040e6"
label_color = "#ffffffff"
label_highlight_color = "#ffc107ff"
min_width = 8
max_width = 499
min_height = 4
max_height = 96

[hints.keys]
left = "leftmeta + space"
right = "leftmeta + i"
grid = "leftmeta + g"
grid_upper_left = "u"
grid_upper_right = "i"
grid_lower_left = "j"
grid_lower_right = "k"
grid_left_click = "space"
grid_right_click = "r"
cancel = "enter"
toggle_background = "leftctrl"
debug = "f8"
